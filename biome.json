{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },
  "linter": {
    "enabled": true,
    "rules": { "recommended": true, "suspicious": { "noExplicitAny": "error", "noConsoleLog": "error" } }
  },
  "files": { "ignore": ["dist", "tests/fixtures", "console/dist", "spikes"] }
}
